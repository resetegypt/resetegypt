{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "pnpm install --frozen-lockfile=false && pnpm --filter @reset/site build",
  "outputDirectory": "out",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "framework": null,
  "regions": ["fra1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:locale(fr|en|ar)/formation", "destination": "/formation" },
    { "source": "/:locale(fr|en|ar)/formation/:path*", "destination": "/formation/:path*" },
    { "source": "/:locale(fr|en|ar)/legal", "destination": "/legal" },
    { "source": "/:locale(fr|en|ar)/privacy", "destination": "/privacy" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://api.reset-egypt.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://book.reset-egypt.com"
        }
      ]
    },
    {
      "source": "/formation/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
