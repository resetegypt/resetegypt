# --- Base ---
DATABASE_URL=postgresql://reset:reset_dev_password@localhost:5432/reset_egypt_dev?schema=public
DIRECT_URL=postgresql://reset:reset_dev_password@localhost:5432/reset_egypt_dev?schema=public
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
REDIS_URL=redis://localhost:6379

# --- Sécurité ---
# JWT_SECRET : signature des cookies de session. >= 16 chars requis. openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32
# ENCRYPTION_KEY : chiffrement AES-GCM des secrets stockés (totpSecret, futurs PII).
# >= 32 chars. Si absent, fallback silencieux sur JWT_SECRET (warning en prod).
# openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-chars-min-openssl-rand-base64-32-please

# --- Email (Resend en prod, MailHog en dev) ---
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Reset Egypt <noreply@reset-egypt.com>

# --- Webhook inbound email (Cloudflare Worker → API) ---
INBOUND_EMAIL_SECRET=

# --- Supabase Storage (pièces jointes emails, avatars) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- URLs publiques (utilisées dans les emails, CORS, CSP) ---
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
BOOKING_URL=https://book.reset-egypt.com
SITE_URL=https://reset-egypt.com

# --- Coordonnées du centre (emails patients + WhatsApp) ---
CENTER_EMAIL=contact@reset-egypt.com
CENTER_PHONE=+201234567890
CENTER_WHATSAPP=201234567890

# --- Monitoring Sentry (optionnel) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
